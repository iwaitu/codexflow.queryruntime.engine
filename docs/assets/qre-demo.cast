{"version": 2, "width": 96, "height": 28, "timestamp": 1780506000, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.8, "o", "QRE: run -> trace -> replay\r\n"]
[1.15, "o", "\r\n"]
[1.95, "o", "$ qre run -w demo --response \"offline model\" --json \"What does QRE do?\"\r\n"]
[2.75, "o", "{\r\n"]
[3.55, "o", "  \"type\": \"qre.run.completed\",\r\n"]
[4.35, "o", "  \"finalText\": \"QRE turns an agent run into a recorded trace you can inspect and replay.\",\r\n"]
[5.15, "o", "  \"traceFilePath\": \"demo/.qre/runs/<run-id>/events.jsonl\",\r\n"]
[5.95, "o", "  \"totalRounds\": 1, \"totalToolCalls\": 0\r\n"]
[6.75, "o", "}\r\n"]
[7.1, "o", "\r\n"]
[7.9, "o", "$ qre trace latest --workspace demo --jsonl\r\n"]
[8.7, "o", "{\"eventType\":\"run.started\",\"prompt\":\"What does QRE do?\"}\r\n"]
[9.5, "o", "{\"eventType\":\"round.started\"}\r\n"]
[10.3, "o", "{\"eventType\":\"model.request\",\"messageCount\":2,\"toolCallsAllowed\":false}\r\n"]
[11.1, "o", "{\"eventType\":\"model.response\",\"assistantTextLength\":72,\"toolCalls\":0}\r\n"]
[11.9, "o", "{\"eventType\":\"round.completed\"}\r\n"]
[12.7, "o", "{\"eventType\":\"runtime.terminated\",\"reason\":\"NoToolCalls\",\"totalRounds\":1}\r\n"]
[13.05, "o", "\r\n"]
[13.85, "o", "$ qre replay latest --workspace demo --json\r\n"]
[14.65, "o", "{\r\n"]
[15.45, "o", "  \"type\": \"qre.replay.completed\",\r\n"]
[16.25, "o", "  \"runner\": \"recorded-replay\",\r\n"]
[17.05, "o", "  \"finalText\": \"QRE turns an agent run into a recorded trace you can inspect and replay.\",\r\n"]
[17.85, "o", "  \"totalRounds\": 1, \"totalToolCalls\": 0\r\n"]
[18.65, "o", "}\r\n"]
[19.0, "o", "\r\n"]
[19.8, "o", "Recorded replay: no provider call, no tool re-execution.\r\n"]
[30.0, "o", ""]
