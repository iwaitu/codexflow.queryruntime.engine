<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="VllmChatClient" Version="2.0.25" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodexFlow.QueryRuntime.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Protocol ships only inside the Engine package; the Engine reference becomes the package dependency. -->
    <ProjectReference Include="..\CodexFlow.QueryRuntime.Engine\CodexFlow.QueryRuntime.Engine.csproj" />
    <ProjectReference Include="..\CodexFlow.QueryRuntime.Protocol\CodexFlow.QueryRuntime.Protocol.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
